# Configuración del Servidor
PORT=3000

# Base de Datos MongoDB
# Ejemplo de URI local: mongodb://localhost:27017/turismo-deportivo
# Ejemplo de URI MongoDB Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/turismo-deportivo
MONGO_URI=mongodb://localhost:27017/turismo-deportivo

# Autenticación JWT
# Generar un secreto seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_secreto_super_seguro_aqui

# Google OAuth
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# URL Base del Backend
# En producción, cambiar a la URL de tu servidor desplegado
BASE_URL=http://localhost:3000
